      "provenance": "Semtech-authored datasheet hosted by DigiKey",
      "version_caveat": "The current Semtech product page lists revision 2.2; these numerical points were verified against the accessible revision 2.1."
    },
    "scope": {
      "description": "All points from the previously reported verified sample matrices, not the complete supported configuration space.",
      "lora_spreading_factors": [
        5,
