      "flrc_effective_rates_kbps": [
        195,
        390,
        975,
        1950
      ],
      "point_count": 40,
      "lora_2400_missing_bandwidths_note": "No inferred sensitivities for 125 or 250 kHz at 2.4 GHz. Use the actual tabulated bandwidths in this dataset."
    },
    "rate_assumptions": {
      "lora_coding_rate": "4/5",
      "lora_rate_formula": "rate_kbps = SF * bandwidth_khz / 2**SF * (4/5)",
      "lora_rate_interpretation": "Nominal bitrate, not measured payload throughput. Preamble, header, CRC, finite-packet effects, low-data-rate optimization (LDRO), MAC scheduling, acknowledgements and retransmissions are excluded.",
      "flrc_coding_rate": "3/4",
      "flrc_rate_formula": "effective_rate_kbps = raw_rate_kbps * (3/4)",
      "flrc_rate_interpretation": "Coding-adjusted PHY rate before packet and MAC overhead. The advertised 2.6 Mbps maximum uses CR=1; that uncoded configuration is not included here."
    },
    "sensitivity_test_criteria": {
      "general": "Manufacturer reference-design typical sensitivity, with G13 and rx_boost=7 where tabulated. Not measured end-to-end application thresholds.",
      "general_rf_conditions": "Datasheet general conditions specify the LF reference design around 915/869 MHz and HF around 2.45 GHz, SIMO power and no RF shield. Dataset labels 915 and 2400 MHz identify the intended bands.",
      "lora_915": "Table 3-17: 1% packet error rate, 64-byte payload; CR4/5, G13, rx_boost=7.",
      "lora_2400": "Table 3-18 title specifies 64-byte payload, but adjacent introductory text inconsistently says both 64B and 20 Bytes at 1% PER. This ambiguity is retained rather than silently resolved. G13, rx_boost=7.",
      "flrc_915": "Table 3-12: 1% packet error rate; CR3/4, G13, rx_boost=7. The table introduction does not specify a packet length.",
      "flrc_2400": "Table 3-13: 1% packet error rate, 31-byte packets; CR3/4, G13, rx_boost=7.",
      "cross_mode_comparison_caution": "Packet lengths and test criteria are not perfectly uniform across these tables or across other radio manufacturers."
    },
    "power_and_bandwidth_assumptions": {
      "tx_dbm_interpretation": "Maximum listed bare-chip transmit capability: +22 dBm sub-GHz and +12 dBm at 2.4 GHz. These are scenario assumptions, not a determination of permitted EIRP or module output.",
      "antenna_and_system_losses": "Antenna gain, feed loss, implementation loss, interference and fade margin are not included.",
      "flrc_bandwidth_caveat": "Use revised modem bandwidths from Table 18-1 (307/571/1333/2666 kHz). The sensitivity tables retain older rounded bandwidth labels for some settings. These are modem configuration bandwidths, not guaranteed occupied-spectrum widths or channel separation rules."
    },
    "plot_guidance": {
      "normalized_budget_formula": "tx_dbm - sensitivity_dbm - 20*log10(frequency_mhz/915)",
      "interpretation": "A fixed-antenna-gain free-space frequency-normalized link-budget proxy. It is not a measured distance or terrain propagation prediction.",
      "pareto_caution": "A rate-versus-normalized-budget frontier omits bandwidth occupancy, spectrum scarcity, power consumption, latency, interference and actual packet goodput. A frontier of this dataset is a frontier of selected settings only."
    }
  },
